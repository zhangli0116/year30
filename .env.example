# 复制为 .env 并按需修改（.env 已被 gitignore，不会提交）
# 服务监听地址（python -m app.main 启动时生效）
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
# 热重载：开发时改代码自动生效；Windows 上 reload 偶发崩溃，默认 false（改 .env 后需重启生效）
HTTP_RELOAD=false

# 数据库连接配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=fund_invest

# CORS 允许来源；"*" 表示全部放开，也可逗号分隔如 http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=*

# 定时同步行情（工作日收盘后自动同步一次历史日线 + 权益/现金流）
SYNC_HOUR=17
SYNC_MINUTE=30
